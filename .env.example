# ALVIREYA hero concierge. Copy to .env.local for development.
# Every value here is a placeholder. Never commit real credentials.

# Master switch. Anything other than "true" keeps the live AI off (curated matches only).
AI_ENABLED=false

# Anthropic. Server-side only, never prefix with NEXT_PUBLIC.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Signs visitor cookies and conversation proofs. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SESSION_SECRET=

# Durable quota store (Upstash Redis REST, free plan is enough).
# The Vercel Marketplace integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both names work.
# Without a store the live AI stays off in production (fails closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Origins allowed to call /api/concierge (comma separated). Localhost is added automatically outside production.
AI_ALLOWED_ORIGINS=https://alvireya.webbinghub.io

# Limits (defaults shown).
AI_VISITOR_DAILY_LIMIT=5
AI_IP_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
AI_VISITOR_MINUTE_LIMIT=4
AI_IP_MINUTE_LIMIT=8
AI_MAX_MESSAGE_CHARS=500
AI_MAX_OUTPUT_TOKENS=350
AI_MAX_INPUT_TOKENS=6000
AI_MAX_TURNS=6
AI_TIMEOUT_MS=20000
AI_MIN_DWELL_MS=1000

# Spend ceiling per UTC day, using conservative token estimates.
AI_DAILY_BUDGET_USD=0.10
AI_INPUT_USD_PER_MTOK=0.10
AI_OUTPUT_USD_PER_MTOK=0.50

# Development only (ignored when NODE_ENV=production).
# AI_QUOTA_STORE=memory
# AI_MOCK_MODEL=true
